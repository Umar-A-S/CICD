# --- Dependency Directories ---
/node_modules
/vendor

# --- Sensitive Files ---
# Kita ignore .env asli agar tidak masuk ke image, 
# karena CI/CD kamu sudah membuat .env sendiri saat build.
.env
.env.*
!.env.example
*.key

# --- Git Files ---
.git
.gitignore
.gitattributes

# --- Laravel Logs & Cache ---
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!bootstrap/cache/.gitkeep

# --- IDE & OS Files ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Testing ---
# PENTING: Jangan masukkan 'tests/' dan 'phpunit.xml' di sini 
# karena CI/CD kamu butuh file ini untuk langkah "Install & Migrate (Testing)".
.phpunit.result.cache

# --- Public Assets (Sering di-ignore jika aset dicompile via CI) ---
public/hot
public/storage
npm-debug.log
yarn-error.log

# --- Docker & CI/CD Config ---
# Kita tidak butuh file config docker/ci ini di dalam image production.
Dockerfile
docker-compose.yml
.dockerignore
.github/